    "func": "const b=msg.payload||{},gate=String(b.gate_id||'').toLowerCase(),uid=String(b.uid||'').replace(/\\\\s/g,'').toUpperCase();if(!['entry','exit'].includes(gate)||!/^[A-F0-9]{4,32}$/.test(uid)){msg.statusCode=400;msg.payload={ok:false,error:'gate_id entry/exit dan UID hex 4-32 karakter wajib'};return [null,msg]}msg.scan={gate,uid,request:'http-'+Date.now().toString(36)+Math.random().toString(36).slice(2,7)};msg.topic='INSERT INTO access_events(request_id,gate_id,card_uid,created_at) VALUES(?,?,?,?)';msg.payload=[msg.scan.request,gate,uid,new Date().toISOString()];return [msg,null];",
