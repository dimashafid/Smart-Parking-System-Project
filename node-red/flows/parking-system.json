    "func": "let b=msg.payload;if(typeof b==='string'){try{b=JSON.parse(b)}catch(e){return null}}const gate=String(b.gate_id||msg.topic.split('/')[1]),state=String(b.state||'unknown').toLowerCase();if(!['entry','exit'].includes(gate)||!['open','closed','moving','unknown'].includes(state))return null;msg.statusData={gate,state,device:b.device_id||'ESP32',command_id:b.command_id||null,result:b.result||null,ts:new Date().toISOString()};msg.topic='INSERT INTO gate_status(gate_id,reported_state,connected,last_seen_at,last_device_id) VALUES(?,?,1,?,?) ON CONFLICT(gate_id) DO UPDATE SET reported_state=excluded.reported_state,connected=1,last_seen_at=excluded.last_seen_at,last_device_id=excluded.last_device_id';msg.payload=[gate,state,msg.statusData.ts,msg.statusData.device];return msg;",
