  {
    "id": "template_dashboard",
    "type": "template",
    "z": "sp_tab",
    "name": "Dashboard UI",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html><html lang=\"id\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Smart Parking</title><style>body{margin:0;background:#0b1220;color:#e8eef8;font:15px system-ui}.wrap{max-width:1200px;margin:auto;padding:25px}.muted{color:#91a0b7}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:20px 0}.panel,.metric{background:#111c2e;border:1px solid #26364d;border-radius:14px;padding:17px}.num{font-size:30px;font-weight:800}.gates{display:grid;grid-template-columns:1fr 1fr;gap:12px}button{background:#2563eb;color:white;border:0;border-radius:8px;padding:10px 14px;margin:4px;cursor:pointer}.secondary{background:#34445d}input{display:block;width:95%;padding:10px;margin:7px 0 12px;background:#0b1525;border:1px solid #34445d;border-radius:8px;color:white}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #26364d;font-size:13px}.scroll{overflow:auto}@media(max-width:750px){.grid{grid-template-columns:repeat(2,1fr)}.gates{grid-template-columns:1fr}}@media(max-width:480px){.wrap{padding:13px}}</style><main class=\"wrap\"><header><h2>▦ SMART PARKING</h2><p class=\"muted\">RFID access · gate monitoring · parking operations <span id=\"conn\">Connecting…</span></p></header><section class=\"grid\"><div class=\"metric\">Kendaraan di dalam<div class=\"num\" id=\"inside\">—</div></div><div class=\"metric\">Masuk hari ini<div class=\"num\" id=\"ent\">—</div></div><div class=\"metric\">Keluar hari ini<div class=\"num\" id=\"ext\">—</div></div><div class=\"metric\">Kartu aktif<div class=\"num\" id=\"cardsN\">—</div></div></section><section class=\"panel\"><h3>Monitoring palang</h3><div class=\"gates\"><div><b>ENTRY</b><p id=\"entryState\">Unknown</p><button onclick=\"gate('entry','OPEN')\">Buka</button><button class=\"secondary\" onclick=\"gate('entry','CLOSE')\">Tutup</button></div><div><b>EXIT</b><p id=\"exitState\">Unknown</p><button onclick=\"gate('exit','OPEN')\">Buka</button><button class=\"secondary\" onclick=\"gate('exit','CLOSE')\">Tutup</button></div></div><small class=\"muted\">Status berdasarkan laporan ESP32, bukan sensor posisi palang.</small></section><section class=\"gates\" style=\"margin-top:14px\"><div class=\"panel\"><h3>Riwayat parkir</h3><div class=\"scroll\"><table><thead><tr><th>UID</th><th>Plat</th><th>Masuk</th><th>Keluar</th><th>Status</th></tr></thead><tbody id=\"history\"></tbody></table></div></div><div class=\"panel\"><h3>Daftarkan kartu</h3><form id=\"reg\"><label>UID RFID</label><input name=\"uid\" required pattern=\"[A-Fa-f0-9]{4,32}\" placeholder=\"A1B2C3D4\"><label>Nama pemilik</label><input name=\"owner_name\" required><label>Nomor kendaraan</label><input name=\"vehicle_plate\"><button>Simpan kartu</button></form><p id=\"notice\" class=\"muted\"></p><h3>Kartu terdaftar</h3><div class=\"scroll\"><table><thead><tr><th>UID</th><th>Pemilik</th><th>Plat</th><th>Status</th></tr></thead><tbody id=\"cardRows\"></tbody></table></div></div></section><p class=\"muted\">Prototype akademik. Gunakan pada LAN pengembangan.</p></main><script>const $=id=>document.getElementById(id),api=async(u,o={})=>{let r=await fetch(u,{headers:{'Content-Type':'application/json'},...o}),d=await r.json();if(!r.ok)throw Error(d.error||'Request gagal');return d},fmt=v=>v?new Date(v).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'—';async function refresh(){try{let [s,g,h,c]=await Promise.all(['/api/summary','/api/gates','/api/history','/api/cards'].map(api));$('conn').textContent='● API online';$('inside').textContent=s.inside;$('ent').textContent=s.entries_today;$('ext').textContent=s.exits_today;$('cardsN').textContent=s.active_cards;g.forEach(x=>$(x.gate_id+'State').textContent=(x.connected?'Online':'Offline')+' · '+x.reported_state);$('history').innerHTML=h.map(x=>'<tr><td>'+x.card_uid+'</td><td>'+(x.vehicle_plate||'—')+'</td><td>'+fmt(x.entry_at)+'</td><td>'+fmt(x.exit_at)+'</td><td>'+x.status+'</td></tr>').join('');$('cardRows').innerHTML=c.map(x=>'<tr><td>'+x.uid+'</td><td>'+x.owner_name+'</td><td>'+(x.vehicle_plate||'—')+'</td><td>'+(x.is_active?'Aktif':'Nonaktif')+'</td></tr>').join('')}catch(e){$('conn').textContent='● API offline'}}async function gate(g,c){if(!confirm('Kirim '+c+' ke '+g+'?'))return;try{await api('/api/gates/command',{method:'POST',body:JSON.stringify({gate_id:g,command:c,source:'dashboard'})});alert('Perintah dicatat, menunggu perangkat.')}catch(e){alert(e.message)}}$('reg').onsubmit=async e=>{e.preventDefault();try{await api('/api/cards/register',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});$('notice').textContent='Kartu tersimpan';e.target.reset();refresh()}catch(x){$('notice').textContent=x.message}};refresh();setInterval(refresh,3000)</script></html>",
